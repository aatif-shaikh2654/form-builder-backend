        "label": "get_current_user",
        "kind": 2,
        "importPath": "app.core.dependencies",
        "description": "app.core.dependencies",
        "peekOfCode": "def get_current_user(access_token: Annotated[str | None, Cookie()] = None) -> str:\n    if not access_token:\n        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=\"Not authenticated\")\n    try: \n        payload = jwt.decode(access_token, JWT_SECRET_KEY, algorithms=[JWT_ALGORITHM])\n        if payload[\"type\"] != \"access\":\n            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Invalid access token\")\n        user_id = payload[\"sub\"]\n        if not user_id:\n            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Invalid access token\")",
        "detail": "app.core.dependencies",
        "documentation": {}
    },
